node_modules
dist

# Volar / editor: generated next to Vue SFCs — must not be committed (also confuses tooling)
**/*.vue.js

# TS→JS compiled output emitted next to sources — Vite/esbuild does the real build,
# so any .js under client/src is a stray artifact, never a source file.
client/src/**/*.js

# TypeScript incremental build cache
*.tsbuildinfo

.env
.env.local
.env.*.local
*.log
.DS_Store

# AI response cache (regenerated on demand)
**/cache/

# EXCEPTION: the learning book is NOT regenerable — settled outcomes are real
# elapsed time, and a truncated write once destroyed 90 days of it with no
# remote copy. Tracked so git is the off-machine backup of last resort.
#
# git will not descend into an excluded DIRECTORY, so a bare `!.../snapshots.json`
# under `**/cache/` never takes effect. Every parent has to be re-included and
# then re-excluded by contents — hence the ladder below. Order matters.
!server/cache/
server/cache/*
!server/cache/recommendations/
server/cache/recommendations/*
!server/cache/recommendations/snapshots.json

# The `server/cache/*` line above already re-excludes everything else, so the
# portfolio bridge files (full position book, cost basis, cash, net worth) stay
# out of git. Listed explicitly anyway: this is the one mistake that must never
# be made silently. See scripts/backup-state.sh for their private backup path.
server/cache/rh-*.json

# Self-accumulated IV history (runtime data, per-deployment)
server/data/iv-history.json

# Scraped transcript cache (runtime data, 30-day TTL)
server/data/transcripts/

# Daily CBOE chain archive (runtime data for offline replay, per-deployment)
server/data/chains/

# Local RH bridge / scratch under data (defense-in-depth; real account data)
server/data/*.json
!server/data/view-skill.json
